{
  "name": "packaged/api",
  "description": "Generic API Abstraction",
  "license": "MIT",
  "authors": [
    {
      "name": "Brooke Bryan",
      "email": "brooke@bajb.net"
    }
  ],
  "require": {
    "php": ">=7.4",
    "guzzlehttp/guzzle": "^6.3|^7.0",
    "symfony/serializer": "^3.4|^4.4|^5.4|^6.4|^7.0|^8.0",
    "packaged/helpers": "^1.30|^2.0|^3.0",
    "packaged/docblock": "~0|~1",
    "packaged/config": "~1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Packaged\\Api\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Packaged\\Api\\Tests\\": "tests"
    }
  }
}
